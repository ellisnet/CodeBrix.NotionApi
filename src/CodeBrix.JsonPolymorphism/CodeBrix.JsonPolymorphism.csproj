<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.JsonPolymorphism</AssemblyName>
    <RootNamespace>CodeBrix.JsonPolymorphism</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      This assembly is delivered inside the CodeBrix.NotionApi.MitLicenseForever
      NuGet package (see CodeBrix.NotionApi.csproj) — it is never packed as its
      own package, deviating deliberately from the one-csproj-one-nupkg norm.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Product>CodeBrix.JsonPolymorphism</Product>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
  </PropertyGroup>

</Project>
